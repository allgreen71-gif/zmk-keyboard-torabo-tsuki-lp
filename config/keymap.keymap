#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener { input-processors = <&zip_temp_layer 1 250>; };

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    macros {
        l0g1n: l0g1n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp N &kp LS(O) &kp LS(F) &kp M &kp Y &kp W &kp O &kp R &kp D &kp LS(0x87)>;
            label = "L0G1N";
        };

        pass1n: pass1n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(Q) &kp A &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp LS(0x87)>;
            label = "PASS1N";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none                    &none     &none         &none        &none          &none                              &none      &none  &none      &none           &none                  &none
&kp ESCAPE               &kp Q     &kp W         &kp E        &kp R          &kp T                              &kp Y      &kp U  &kp I      &kp O           &kp P                  &kp BSPC
&kp TAB                  &kp A     &kp S         &kp D        &kp F          &kp G    &none        &none        &kp H      &kp J  &kp K      &kp L           &kp SEMICOLON          &lt 1 SINGLE_QUOTE
&mt LSHFT LEFT_BRACKET   &kp Z     &kp X         &kp C        &kp V          &kp B    &kp DEL      &kp B        &kp N      &kp M  &kp COMMA  &kp PERIOD      &kp SLASH              &mt RIGHT_SHIFT LS(0x87)
&mt LCTRL RIGHT_BRACKET  &kp LGUI  &kp LEFT_ALT  &lt 2 GRAVE  &kp BACKSPACE  &kp TAB  &lt 1 SPACE  &lt 2 SPACE  &kp ENTER  &none  &none      &kp LANGUAGE_1  &mt RIGHT_ALT INT_YEN  &mt LCTRL BACKSLASH
            >;
        };

        layer_1 {
            bindings = <
&none   &none            &none         &none         &none         &none                                         &none             &none           &none      &none                 &none      &none
&trans  &kp EXCLAMATION  &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT                                   &kp CARET         &kp AMPS        &kp ASTRK  &kp LEFT_PARENTHESIS  &kp MINUS  &trans
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &none           &none            &kp LEFT_BRACKET  &kp LEFT_ARROW  &kp DOWN   &kp UP_ARROW          &kp RIGHT  &trans
&trans  &kp NUMBER_6     &kp N7        &kp N8        &kp N9        &kp N0       &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp EQUAL         &kp 0x89        &trans     &trans                &trans     &trans
&trans  &trans           &trans        &trans        &trans        &trans       &trans          &lt 3 SPACE      &trans            &none           &none      &trans                &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&none   &none      &none      &none      &none      &none                   &none   &none           &none      &none          &none      &none
&trans  &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                  &kp F6  &kp F7          &kp F8     &kp F9         &kp F10    &trans
&trans  &kp F11    &kp F12    &trans     &trans     &trans  &none   &none   &trans  &kp LEFT_ARROW  &kp DOWN   &kp UP_ARROW   &kp RIGHT  &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans  &trans  &trans  &trans  &kp HOME        &kp PG_UP  &kp PAGE_DOWN  &kp END    &trans
&trans  &trans     &trans     &trans     &trans     &trans  &trans  &trans  &trans  &none           &none      &trans         &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&none   &none     &none         &none       &none       &none                       &none       &none         &none         &none         &none      &none
&trans  &trans    &kp UP_ARROW  &trans      &l0g1n      &pass1n                     &kp ASTRK   &kp N7        &kp N8        &kp N9        &kp MINUS  &trans
&trans  &kp LEFT  &kp DOWN      &kp RIGHT   &trans      &trans      &trans  &trans  &kp PERIOD  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS   &trans
&trans  &trans    &trans        &bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &trans  &trans  &kp N0      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &trans
&trans  &trans    &trans        &trans      &trans      &trans      &trans  &trans  &trans      &none         &none         &trans        &trans     &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp RC(X)  &kp RC(C)  &kp RC(V)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
            >;
        };
    };
};
